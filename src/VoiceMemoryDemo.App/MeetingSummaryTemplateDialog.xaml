<Window x:Class="VoiceMemoryDemo.App.MeetingSummaryTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑总结模板" Width="820" Height="690" MinWidth="680" MinHeight="560"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="30,26,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="总结模板" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="定义新会议报告的章节、顺序和关注重点"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,6,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#18231F" BorderBrush="#315748" BorderThickness="1"
                    CornerRadius="7" Padding="10,5" VerticalAlignment="Top">
                <TextBlock Text="仅用于新报告" Foreground="#75D8AA" FontSize="11" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="#14171D" BorderBrush="#292E38" BorderThickness="1"
                CornerRadius="10" Padding="15,12" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="模板会与完整转写一起发送给模型。你可以改变报告格式，但事实核验、数字校验和禁止虚构行动项等规则始终生效。"
                           FontSize="12" Foreground="#BCC3CD" LineHeight="19" />
                <TextBlock x:Name="SummaryHeadingHint" Text="请保留“## 核心摘要”，历史报告列表会读取这一节作为卡片概览。"
                           FontSize="11" Foreground="#D9A266" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="#101319" BorderBrush="#303641" BorderThickness="1" CornerRadius="11" Padding="2">
            <TextBox x:Name="TemplateTextBox" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0" Padding="16,14" FontSize="13" TextBlock.LineHeight="21"
                     MaxLength="8000" TextChanged="TemplateTextBox_TextChanged" />
        </Border>

        <Grid Grid.Row="4" Margin="2,9,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText" Foreground="#FF8585" FontSize="11" Visibility="Collapsed" />
            <TextBlock x:Name="TemplateLengthText" Grid.Column="1" Foreground="#737C89" FontSize="11" />
        </Grid>

        <Grid Grid.Row="5" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="还原默认模板" MinWidth="118" HorizontalAlignment="Left"
                    Click="RestoreDefaultButton_Click" />
            <Button Grid.Column="1" Content="取消" MinWidth="92" Margin="0,0,10,0"
                    Click="CancelButton_Click" IsCancel="True" />
            <Button Grid.Column="2" Content="保存模板" MinWidth="104" Click="SaveButton_Click" IsDefault="True"
                    Background="#3A2A1C" BorderBrush="#8A5B2D" Foreground="#FFC27B" />
        </Grid>
    </Grid>
</Window>
