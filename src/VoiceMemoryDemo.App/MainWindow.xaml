                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="← 返回" Click="BackToMeetingReportsButton_Click" Padding="13,7" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="MeetingReportPreviewTitleText" Text="会议报告" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="MeetingReportPreviewMetaText" Text="" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                                <Button x:Name="CopyMeetingReportButton" Content="复制全文" Click="CopyMeetingReportButton_Click" IsEnabled="False" MinWidth="90" />
                                <Button x:Name="ExportMeetingReportButton" Content="导出…" Click="ExportMeetingReportButton_Click" IsEnabled="False" MinWidth="80" Margin="8,0,0,0" />
                                <Button Content="打开报告文件夹" Click="OpenMeetingFolderButton_Click" MinWidth="116" Margin="8,0,0,0" />
                            </WrapPanel>
                        </Grid>
                        <Border Grid.Row="2" Background="#111419" BorderBrush="#292E38" BorderThickness="1" CornerRadius="12" Padding="2">
                            <FlowDocumentScrollViewer x:Name="MeetingReportDocumentViewer" IsToolBarVisible="False"
                                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                      Background="Transparent" BorderThickness="0" />
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="记忆">
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="表达偏好" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="告诉它你喜欢怎样表达。例如：工作消息要简洁，不要使用感叹号。" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,16,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="PreferenceInput" MinHeight="42" />
                                <Button Grid.Column="1" Content="添加" Click="AddPreference_Click" Margin="8,0,0,0" />
                            </Grid>
                            <Grid Grid.Row="2">
                                <ListBox x:Name="MemoryList" Background="#A910141D" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource PrimaryTextBrush}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Content}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="删除" Tag="{Binding Id}" Click="DeletePreference_Click" Margin="10,0,0,0" Padding="10,5" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border x:Name="MemoryEmptyPanel" Background="#A910141D" BorderBrush="#354057" BorderThickness="1" CornerRadius="11" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                                        <TextBlock Text="✦" Foreground="{StaticResource AccentCyanBrush}" FontSize="26" HorizontalAlignment="Center" />
                                        <TextBlock Text="小夜还不知道你的表达偏好" FontSize="15" FontWeight="SemiBold" Margin="0,9,0,0" HorizontalAlignment="Center" />
                                        <TextBlock Text="在上方写下一条，例如“工作消息尽量简洁”。" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="专有词纠错" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="把容易听错的词固定下来。之后会先本地替换，再交给小模型整理。"
                                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,18,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="管理纠错词" Click="OpenCorrectionDictionaryButton_Click"
                                        Padding="12,7" VerticalAlignment="Top" ToolTip="查看、编辑或删除已经记住的纠错习惯" />
                            </Grid>
                            <TextBlock Text="经常识别成" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBox x:Name="SpokenWordInput" Margin="0,7,0,14" />
                            <TextBlock Text="你希望写成" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBox x:Name="PreferredWordInput" Margin="0,7,0,16" />
                            <Button Content="保存这个词" Click="AddCorrection_Click" Background="#252A34" />
                            <Border Background="#A910141D" BorderBrush="#303A50" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="写法示例" Foreground="#7F8998" FontSize="10" Margin="0,0,0,7" />
                                    <TextBlock Text="“扣的可斯”  →  “Codex”" Foreground="#AEB8CE" />
                                    <TextBlock Text="“迪普西克”  →  “DeepSeek”" Foreground="#AEB8CE" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="连接设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
                            <StackPanel>
                                <TextBlock Text="腾讯云实时 ASR" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="负责把麦克风声音实时变成文字" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,18" />
                                <TextBlock Text="AppID" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="TencentAppIdBox" Margin="0,6,0,12" />
                                <TextBlock Text="SecretID" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="TencentSecretIdBox" Margin="0,6,0,12" />
                                <TextBlock Text="SecretKey" Foreground="{StaticResource SecondaryTextBrush}" />
                                <PasswordBox x:Name="TencentSecretKeyBox" Margin="0,6,0,12" />
                                <TextBlock Text="识别引擎" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="TencentEngineBox" Text="16k_zh" Margin="0,6,0,14" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="打开腾讯 ASR 控制台" Click="OpenTencentConsole_Click" />
                                    <Button Content="API 密钥管理" Click="OpenTencentKeys_Click" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
                            <StackPanel>
                                <TextBlock Text="DeepSeek 文本整理与翻译" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="负责去口头禅、修标点、套用表达偏好并翻译目标语言" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,18" />
                                <TextBlock Text="API Key" Foreground="{StaticResource SecondaryTextBrush}" />
                                <PasswordBox x:Name="DeepSeekApiKeyBox" Margin="0,6,0,12" />
                                <TextBlock Text="模型名（可替换）" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="DeepSeekModelBox" Text="deepseek-v4-flash" Margin="0,6,0,12" />
                                <TextBlock Text="API 地址" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="DeepSeekBaseUrlBox" Text="https://api.deepseek.com" Margin="0,6,0,14" />
                                <CheckBox x:Name="EnableAiCheckBox" Content="启用 AI 文本整理" IsChecked="True" Margin="0,0,0,10" />
                                <CheckBox x:Name="SaveHistoryCheckBox" Content="把原文和成文保存在本机历史中" IsChecked="True" />
                                <Button Content="打开 DeepSeek 平台" Click="OpenDeepSeek_Click" Margin="0,18,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Background="#15120F" BorderBrush="#4A3524" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,500,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="ConfigStatusText" Text="密钥只会用 Windows 当前账户加密后保存在本机。" Foreground="#D6B48E" />
                                    <TextBlock Text="项目文件和日志里不会保存或显示你的 SecretKey。" Foreground="#846E58" FontSize="11" Margin="0,4,0,0" />
                                    <TextBlock Text="启用 AI 时，本次文字和少量命中记忆会发送给 DeepSeek；音频不会。" Foreground="#846E58" FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="保存设置" Click="SaveSettings_Click" Background="{StaticResource AccentBrush}" Foreground="#17100A" FontWeight="Bold" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        </Grid>
    </Grid>
</Window>
