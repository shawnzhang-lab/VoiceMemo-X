<Window x:Class="VoiceMemoryDemo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="速说速记X" Icon="Assets/app-icon-xiaoye-v4.ico" Width="1080" Height="700" MinWidth="940" MinHeight="620"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="LanguageComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#EAF2F8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Margin="3,2">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#263A4D" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#315268" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LanguageComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#EDF5FA" />
            <Setter Property="Background" Value="#101822" />
            <Setter Property="BorderBrush" Value="#41566C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0,38,0" />
            <Setter Property="MaxDropDownHeight" Value="270" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource LanguageComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="FieldBorder" Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                CornerRadius="10">
                                            <Grid>
                                                <Border Width="30" HorizontalAlignment="Right" Background="#162330" CornerRadius="0,9,9,0">
                                                    <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0" Stroke="#9FB4C5" StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#62D8EB" />
                                                <Setter TargetName="Arrow" Property="Stroke" Value="#62D8EB" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#62D8EB" />
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="180" CenterX="4" CenterY="2" /></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBlock x:Name="SelectedLanguageText"
                                       IsHitTestVisible="False"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Text="{Binding SelectedItem.Content, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextWrapping="Wrap" />

                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" StaysOpen="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Width="{Binding PlacementTarget.ActualWidth, ElementName=PART_Popup}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,5,0,0"
                                        Background="#101822" BorderBrush="#45647A" BorderThickness="1"
                                        CornerRadius="12" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Opacity="0.55" />
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#62D8EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Foreground" Value="#91A2B2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid ClipToBounds="True">
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.45" EndPoint="1,0.55">
                    <GradientStop Color="#FF090D17" Offset="0" />
                    <GradientStop Color="#FF0A0F1B" Offset="0.53" />
                    <GradientStop Color="#FF0B1020" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Grid IsHitTestVisible="False">
            <Ellipse Width="260" Height="260" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-95,0,0,-120" Opacity="0.14">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#8462D8EB" Offset="0" /><GradientStop Color="#0062D8EB" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="0" To="-24" Duration="0:0:4.8" />
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.10" To="0.20" Duration="0:0:4.8" />
                    </Storyboard></BeginStoryboard></EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <TextBlock Text="✦" Foreground="#8D7AD7" FontSize="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,118,280,0" Opacity="0.28">
                <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                <TextBlock.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.18" To="0.65" Duration="0:0:2.9" />
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="0" To="-9" Duration="0:0:2.9" />
                </Storyboard></BeginStoryboard></EventTrigger></TextBlock.Triggers>
            </TextBlock>
            <TextBlock Text="✦" Foreground="#62D8EB" FontSize="17" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,80,126" Opacity="0.34">
                <TextBlock.RenderTransform><RotateTransform Angle="0" CenterX="8" CenterY="8" /></TextBlock.RenderTransform>
                <TextBlock.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)" From="0" To="360" Duration="0:0:9" />
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.22" To="0.55" Duration="0:0:4.5" AutoReverse="True" />
                </Storyboard></BeginStoryboard></EventTrigger></TextBlock.Triggers>
            </TextBlock>
        </Grid>

        <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/app-icon-xiaoye-v4.png" Width="46" Height="46" Stretch="Uniform" />
                <StackPanel Margin="13,0,0,0">
                    <TextBlock x:Name="AppTitleText" Text="速说速记X" FontSize="22" FontWeight="SemiBold"
                               Style="{StaticResource DisplayTextStyle}" TextWrapping="NoWrap" />
                    <TextBlock Text="右 Alt 日常输入 · 左 Alt 会议纪要" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Height="88" MaxWidth="440" Margin="24,0,18,0" CornerRadius="18"
                    BorderBrush="#31445A" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect Color="#204E7A" BlurRadius="22" ShadowDepth="0" Opacity="0.28" />
                </Border.Effect>
                <Grid>
                    <Image Source="Assets/ui-header-xiaoye-v2.png" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#EA0A0F1B" Offset="0" />
                                <GradientStop Color="#780A0F1B" Offset="0.38" />
                                <GradientStop Color="#080A0F1B" Offset="0.72" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="22,0,0,0">
                        <TextBlock Text="小夜正在待命" FontSize="12" FontWeight="SemiBold" Foreground="#DDE9F2" />
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Rectangle Width="22" Height="3" RadiusX="1.5" Fill="#62D8EB" Opacity="0.82" />
                            <Rectangle Width="11" Height="3" RadiusX="1.5" Fill="#8D7AD7" Margin="5,0,0,0" Opacity="0.72" />
                            <TextBlock Text="VOICE MEMORY" FontSize="8" Foreground="#708DA1" Margin="8,-4,0,0"
                                       Style="{StaticResource TechnicalTextStyle}" TextWrapping="NoWrap" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Width="118" Height="68" Margin="0,0,12,0" Background="#141C29" BorderBrush="#3C4C63"
                    BorderThickness="1" CornerRadius="14" Padding="13,10" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#173453" BlurRadius="16" ShadowDepth="0" Opacity="0.32" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="#5ED79A" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="HeaderStatusText" Text="准备中" Foreground="#D9E4EF" FontWeight="SemiBold" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,7,0,0">
                        <Rectangle Width="5" Height="6" Fill="#3B7796" RadiusX="2" />
                        <Rectangle Width="5" Height="12" Fill="#62D8EB" RadiusX="2" Margin="5,-3,0,0" />
                        <Rectangle Width="5" Height="8" Fill="#7595D8" RadiusX="2" Margin="5,-1,0,0" />
                        <Rectangle Width="5" Height="14" Fill="#62D8EB" RadiusX="2" Margin="5,-4,0,0" />
                        <Rectangle Width="5" Height="7" Fill="#3B7796" RadiusX="2" Margin="5,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Button x:Name="UiLanguageButton" Grid.Column="3" Width="104" Height="68" Padding="10,8"
                    Background="#172337" BorderBrush="#4B6685" Click="UiLanguageButton_Click"
                    ToolTip="切换客户端、通知和悬浮框语言">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="文/A" Foreground="#62D8EB" FontSize="10" FontWeight="SemiBold"
                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="UiLanguageButtonPrimaryText" Text="English" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#F2F7FF" />
                    </StackPanel>
                    <TextBlock x:Name="UiLanguageButtonSecondaryText" Grid.Row="1" Text="UI language"
                               Foreground="#7F94AA" FontSize="8.5" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </Grid>
            </Button>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="2" Background="Transparent" BorderThickness="0"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="开始输入">
                <ScrollViewer x:Name="HomeScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <StackPanel Margin="0,18,0,0" HorizontalAlignment="Stretch"
                                Width="{Binding ViewportWidth, ElementName=HomeScrollViewer}">
                        <Border Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="24,22,24,24">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="3 步完成语音输入" FontSize="23" FontWeight="SemiBold" />
                                        <TextBlock Text="适用于 Codex、ChatGPT、浏览器、微信和文档等任意输入框。"
                                                   Margin="0,6,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#20252E" CornerRadius="8" Padding="11,6" VerticalAlignment="Center">
                                        <TextBlock Text="不用复制粘贴" Foreground="#D6B48E" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#101319" BorderBrush="#303641" BorderThickness="1" CornerRadius="12" Padding="15,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" Background="#2B3039" CornerRadius="13" VerticalAlignment="Top">
                                                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#D6B48E" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="点一下输入框" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="先把光标放到你想输入文字的位置" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" LineHeight="17" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" Background="#101319" BorderBrush="#4A4036" BorderThickness="1" CornerRadius="12" Padding="15,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" Background="#3A3027" CornerRadius="13" VerticalAlignment="Top">
                                                <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFB25E" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="按右 Alt 开始" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="看到“请输入语音”后，请在 5 秒内开始说" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" LineHeight="17" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="4" Background="#101319" BorderBrush="#303641" BorderThickness="1" CornerRadius="12" Padding="15,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" Background="#2B3039" CornerRadius="13" VerticalAlignment="Top">
                                                <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#D6B48E" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="再按右 Alt 结束" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="文字会自动整理并输入到刚才的位置" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" LineHeight="17" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border Background="#171B22" BorderBrush="#303641" BorderThickness="1" CornerRadius="12" Margin="0,16,0,0" Padding="16,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="当前状态" Foreground="#D6B48E" FontSize="10" FontWeight="SemiBold" />
                                            <TextBlock x:Name="MainStatusText" Text="按一下右 Alt，开始说话" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" />
                                            <TextBlock x:Name="MainHintText" Text="再按一次结束；5 秒内没有检测到语音会自动关闭。" Margin="0,4,16,0" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                            <ProgressBar x:Name="AudioLevelBar" Height="4" Maximum="1" Value="0" Margin="0,11,22,0" Foreground="{StaticResource AccentBrush}" Background="#292E38" BorderThickness="0" />
                                            <TextBlock x:Name="TargetAppText" Text="使用范围：聊天、网页、文档等任意输入框" Margin="0,8,0,0" FontSize="11" Foreground="#778190" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#0E1116" BorderBrush="#3C424D" BorderThickness="1" CornerRadius="10" Padding="14,10" VerticalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="右 Alt" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock Text="开始和结束都按它" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Visibility="Collapsed" Background="#171A31" BorderBrush="#3D4260" BorderThickness="1" CornerRadius="14" Margin="0,16,0,0" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="实时会议纪要" FontSize="16" FontWeight="SemiBold" />
                                        <Border Background="#433768" CornerRadius="6" Padding="7,2" Margin="8,0,0,0">
                                            <TextBlock Text="2.0 Demo" Foreground="#CDBDFF" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="MeetingModeSummaryText" Text="关闭 · 仍使用普通语音输入模式" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" />
                                    <TextBlock Text="开启后：麦克风 + 电脑播放声实时转写并标注说话人1/2/3 → Flash 分段提炼 → Thinking High 总结 → 保存 Markdown"
                                               Foreground="#8E96AC" FontSize="11" Margin="0,7,20,0" TextWrapping="Wrap" />
                                    <TextBlock Text="仅开启此模式时使用腾讯 2.0 说话人分离并产生对应用量；普通语音输入不受影响。"
                                               Foreground="#B8A8E8" FontSize="10" Margin="0,5,20,0" TextWrapping="Wrap" />
                                    <CheckBox x:Name="MeetingSystemAudioCheckBox" Content="同时收录电脑播放声音（飞书 / 微信 / 浏览器中的对方语音）"
                                              Margin="0,11,20,0" Click="MeetingSystemAudioCheckBox_Click" />
                                    <TextBlock x:Name="MeetingAudioSourceText" Text="建议佩戴耳机，避免扬声器声音再次进入麦克风造成回声。"
                                               Foreground="#7F8BA5" FontSize="10" Margin="22,4,20,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox x:Name="MeetingModeCheckBox" Grid.Column="1" Content="开启实时会议模式" VerticalAlignment="Center" Click="MeetingModeCheckBox_Click" />
                            </Grid>
                        </Border>

                        <Border Visibility="Collapsed" Background="#121A1D" BorderBrush="#31505A" BorderThickness="1" CornerRadius="14" Margin="0,12,0,0" Padding="20,16">
                            <StackPanel>
                                <StackPanel>
                                    <TextBlock Text="从音频 / 视频生成会议纪要（暂时保留）" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="选择 MP3、WAV、M4A、AAC、WMA、MP4、MOV 或 M4V；原文件不会被修改。"
                                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="导入会议音视频固定使用腾讯 Speaker 2.0，自动标注说话人并产生对应的说话人分离用量。"
                                               Foreground="#B8A8E8" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ImportFileNameText" Text="尚未选择文件 · 处理时间约等于媒体时长 + 总结时间"
                                               Foreground="#79939C" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                    <Button x:Name="ImportMeetingFileButton" Content="选择文件并生成" Click="ImportMeetingFileButton_Click"
                                            MinWidth="148" Background="#1D3037" BorderBrush="#416873" />
                                    <Button x:Name="CancelMeetingImportButton" Content="取消" Click="CancelMeetingImportButton_Click"
                                            Margin="8,0,0,0" MinWidth="72" Visibility="Collapsed" />
                                </StackPanel>
                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="MeetingImportProgressBar" Height="5" Minimum="0" Maximum="1" Value="0"
                                                 Visibility="Collapsed" Foreground="#62C6FF" Background="#253137" BorderThickness="0" />
                                    <TextBlock x:Name="MeetingImportProgressText" Grid.Column="1" Text="" Margin="12,-5,0,0"
                                               Foreground="#8FA9B1" FontSize="10" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
