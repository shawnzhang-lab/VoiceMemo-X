<Window x:Class="VoiceMemoryDemo.App.DeleteMeetingReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="删除会议报告" Width="450" Height="278" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="38" Height="38" CornerRadius="19" Background="#351A1E" BorderBrush="#74343D" BorderThickness="1">
                <TextBlock Text="×" Foreground="#FF7777" FontSize="25" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
            </Border>
            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="删除这份会议报告？" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="删除后会移入 Windows 回收站" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="#14171D" BorderBrush="#2B3039" BorderThickness="1"
                CornerRadius="10" Padding="15,12" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock x:Name="ReportTitleText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ReportMetaText" Foreground="#848D9A" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="正在生成的会议任务不会被删除。确认后，历史列表和报告详情会立即更新。"
                   Foreground="#9A7C7F" FontSize="11" Margin="0,13,0,0" TextWrapping="Wrap" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" MinWidth="92" Click="CancelButton_Click" IsCancel="True" />
            <Button Content="删除" MinWidth="92" Margin="10,0,0,0" Click="DeleteButton_Click" IsDefault="True"
                    Background="#471F24" BorderBrush="#8B3E48" Foreground="#FF9A9A" />
        </StackPanel>
    </Grid>
</Window>
